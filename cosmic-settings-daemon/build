#!/bin/bash -e

patch -Np1 -i cosmic-settings-daemon-lto.patch
# The libspa crate's C helpers need fat LTO objects to be found at link time
# (see xdg-desktop-portal-cosmic).
export CFLAGS+=' -ffat-lto-objects'
cargo fetch --locked
# 1.10.0 replaced the Makefile with a justfile; the libexec paths and the
# geoclue agent setting are gone, and the polkit rule already allows wheel.
just build-release --frozen
just rootdir=$1 install
